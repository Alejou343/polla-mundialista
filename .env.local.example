# Supabase — copia este archivo a .env.local y rellena los valores reales.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SOLO server-side. Nunca exponer al cliente. Se usa en crons y rutas admin.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Código que los familiares deben introducir al registrarse.
FAMILY_INVITE_CODE=FAMILIA2026

# Token para autenticar invocaciones a /api/cron/* (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=cambia-esto-por-un-token-largo-y-aleatorio
